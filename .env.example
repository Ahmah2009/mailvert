# Copy to .env and adjust. All variables are prefixed MAILVERT_ (see src/mailvert/config.py).

MAILVERT_SMTP_FROM_ADDRESS=verify@yourdomain.com
MAILVERT_SMTP_HELO_HOST=yourdomain.com
MAILVERT_SMTP_TIMEOUT_SECONDS=8
MAILVERT_DNS_TIMEOUT_SECONDS=5

# Most cloud hosts block outbound port 25 — disable the live SMTP handshake
# and fall back to syntax + MX-only verification if yours does too.
MAILVERT_SMTP_PROBE_ENABLED=true

MAILVERT_CACHE_TTL_SECONDS=1800
MAILVERT_RATE_LIMIT=30/minute
MAILVERT_BULK_MAX_ADDRESSES=50
MAILVERT_LOG_LEVEL=INFO
MAILVERT_LOG_JSON=false
